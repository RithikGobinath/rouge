{
  "manifest_version": 3,
  "name": "Rouge Autofill",
  "version": "1.0.0",
  "description": "Connects the Rouge ribbon to browser forms. No UI of its own — popups come from the ribbon.",
  "permissions": ["activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
